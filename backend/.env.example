APP_NAME=QRCAP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qrcap
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173

# Attendance policy defaults (overridable per session)
ATTENDANCE_PRESENT_GRACE_MINUTES=10
ATTENDANCE_QR_ROTATION_SECONDS=30
ATTENDANCE_QR_EXPIRY_SECONDS=60